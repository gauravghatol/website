# Reusable production env template
# Fill values from your secret manager before deploy.

NODE_ENV=production
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?appName=<app-name>
MONGODB_URI_FALLBACK=mongodb://<db_user>:<db_password>@<host1>:27017,<host2>:27017,<host3>:27017/<database>?ssl=true&authSource=admin&replicaSet=<replica-set>&retryWrites=true&w=majority
MONGO_URI=${MONGODB_URI}

# Security secrets (use long random values)
JWT_SECRET=<64+_char_random_secret>
ADMIN_JWT_SECRET=<64+_char_random_admin_secret>
ADMIN_GATE_TOKEN=<40+_char_random_gate_token>

# Ops
ADMIN_AUTO_SEED=false
CORS_ORIGIN=https://your-domain.com

# Initial admin bootstrap account
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=<strong_temp_password>
ADMIN_NAME=Admin
